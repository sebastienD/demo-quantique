from random import randint








c=randint(0,3)
f0 = OracleClassique(0, c)
f1 = OracleClassique(1, c)

if f0 == f1:
    print("L'oracle est constant")
else:
    print("L'oracle est équilibré")
print(c)








def OracleQuantique(U,c):
    if c==1:
        U.add(X(1))
    if c==2:
        U.add(CNOT(0,1))
    if c==3:
        U.add([X(0),CNOT(0,1),X(1)])
        


print(OracleQuantique(2))





c=randint(0,3)
U=QCircuit(2)
U.add(H(0))
OracleQuantique(U,c)
U.add(BasisMeasure(shots=1))
result=run(U,[IBMDevice.AER_SIMULATOR])
result.plot()






